# Website Masjid Nurul Islam

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# Alamat tanpa .html, contoh: domain.com/kajian
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Hapus tanda # pada 2 baris di bawah SETELAH SSL/HTTPS aktif di cPanel
  # RewriteCond %{HTTPS} off
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript text/javascript application/json image/svg+xml application/manifest+json
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff .woff
  AddType application/manifest+json .webmanifest
</IfModule>

# Gambar dan font disimpan lama di browser. Konten dan halaman selalu diperiksa ulang.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType text/javascript "access plus 0 seconds"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
